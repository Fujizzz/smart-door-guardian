# The default is a hardware-free demo mode. Change the access code before real use.
DOOR_DEMO_MODE=true
DOOR_ACCESS_CODE=change-this-demo-code
DOOR_CAMERA_INDEX=0
DOOR_FACE_THRESHOLD=65
DOOR_REQUIRED_MATCHES=5
DOOR_MAX_FRAMES=300

# Default location: Chongqing. Replace with your own coordinates.
WEATHER_LATITUDE=29.5630
WEATHER_LONGITUDE=106.5516
WEATHER_TIMEZONE=Asia/Shanghai

# Optional SMTP alert configuration. Never commit a real .env file.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=your-account@example.com
SMTP_PASSWORD=replace-with-an-app-password
SMTP_SENDER=your-account@example.com
SMTP_RECIPIENT=owner@example.com
SMTP_USE_SSL=true

